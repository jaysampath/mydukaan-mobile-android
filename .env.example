# Copy to .env.dev and .env.prod. Never commit the real files.
#
# APP_ENV selects the Supabase project at BUILD time. There is no runtime
# switch: a prod binary physically cannot reach the dev project.

APP_ENV=dev
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
