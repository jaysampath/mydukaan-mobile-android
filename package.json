{
  "name": "mydukaan",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=20.19.0 <23"
  },
  "scripts": {
    "start": "expo start",
    "dev": "node scripts/run-android.mjs",
    "dev:build": "node scripts/run-android.mjs --build",
    "dev:clear": "node scripts/run-android.mjs --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --clean",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run test",
    "test": "vitest run --exclude \"**/*.contract.test.ts\"",
    "test:watch": "vitest",
    "test:contract": "vitest run src/api/rpc.contract.test.ts",
    "verify:full": "npm run typecheck && npm run test && npm run test:contract"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@supabase/supabase-js": "^2.112.3",
    "@tanstack/query-async-storage-persister": "^5.103.1",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-query-persist-client": "^5.103.1",
    "dotenv": "^16.6.1",
    "expo": "~54.0.37",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.9",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.24",
    "expo-linking": "~8.0.12",
    "expo-localization": "~17.0.9",
    "expo-print": "~15.0.8",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.8",
    "expo-system-ui": "~6.0.9",
    "i18n-js": "^4.5.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^4.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.12",
    "typescript": "~5.9.2",
    "vitest": "^5.0.0"
  }
}
